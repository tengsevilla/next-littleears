# next-littleears — copy to .env.local for local dev (e.g. NEXT_PUBLIC_API_URL=http://localhost:3001).
# Public values only: everything NEXT_PUBLIC_* ends up in the client bundle.

# Backend origin, no trailing slash.
# Production: set in Vercel (Project > Settings > Environment Variables) to https://api.littleears.tenghuey.dev
# It is baked in at build time — into the client bundle AND the service worker's API origin
# (/serwist/sw.js) — so changing it requires a redeploy. The build fails if it is unset.
NEXT_PUBLIC_API_URL=
